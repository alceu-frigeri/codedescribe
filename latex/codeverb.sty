%%%
%%% extending scontents package options !!!!
%%% changing it's default key handling from \msg_error to 'store-env'.
%%%
\keys_define:nn { codeverb / codestore }
  {
    store-env   .tl_set:N         = \l__codeverb_opt_store_tl ,
    store-env   .value_required:n = true ,
    st          .tl_set:N         = \l__codeverb_opt_store_tl ,
    st          .value_required:n = true ,
    store-at    .tl_set:N         = \l__codeverb_opt_store_tl ,
    store-at    .value_required:n = true ,

    unknown     .undefine: ,
    unknown     .code:n           = 
      { 
        \keys_set:ne {codeverb / codestore}
          { store-env = {\l_keys_key_str} } 
      }
 }

\cs_new_protected:Npn  \__codeverb_set_store_seq:n #1
  {
    \seq_if_exist:cF {g__codeverb_store_ #1 _seq}
      {
        \seq_new:c {g__codeverb_store_ #1 _seq}
        \int_new:c {g__codeverb_store_ #1 _int}
        \cs_new:cpe {__codeverb_store_ #1 _gput_right:n} ##1
          {
            \exp_not:N \int_gincr:N \exp_not:c {g__codeverb_store_ #1 _int}
            \exp_not:N \seq_gput_right:Nn \exp_not:c {g__codeverb_store_ #1 _seq} {##1}
          }      
      }
    \cs_set_eq:Nc \__codeverb_store_gput_right:n {__codeverb_store_ #1 _gput_right:n}
  }
\cs_generate_variant:Nn \__codeverb_set_store_seq:n {o} 
\cs_generate_variant:Nn \__codeverb_store_gput_right:n {o} 


\codeverb_new_environment:nnNnn {VerbStore} {O{default}} \g__codeverb_body_tl
  { 
    \tl_if_blank:nTF {#1}
      {
        \keys_set:nn { codeverb / codestore }{default}
      }
      {
        \keys_set:nn { codeverb / codestore }{#1}
      }
    \__codeverb_set_store_seq:o \l__codeverb_opt_store_tl
  }
  {  
    \__codeverb_store_gput_right:o \g__codeverb_body_tl
  }
  
\lstnewenvironment{codeverbatimlst}
  { \__codelist_lstset: }
  {}

\codeverb_new_retokenize_envcs:Nn \__codeverb_listing:n {codeverbatimlst}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\codeverb_new_environment:nnNnn {MYverb} {} \g__codeverb_body_tl
  {}
  {
    \__codeverb_listing:n 
      { \exp_not:V \g__codeverb_body_tl }
  }
  

\NewDocumentCommand \codelisting {mO{1}}
  {
    \__codeverb_listing:n 
      { \seq_item:cn {g__codeverb_store_ #1 _seq}{#2} }
  }


  
\NewDocumentCommand \codedisp {sO{}mO{}}
  {
    \tl_if_blank:nTF {#4}
      {
        \clist_map_inline:nn {#3}
          { \codelisting ##1 }
      }
      {
        \clist_map_inline:nn {#3}
          { 
            \clist_map_inline:nn {#4}
              {
                \codelisting {##1}[####1]
              }
          }
      }
      
  }  


\codeverb_new_retokenize_cs:NN \testexec \g__codeverb_body_tl
  
