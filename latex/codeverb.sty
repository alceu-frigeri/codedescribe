\cs_new_protected:Npn \__codeverb_new_retokenize_envcs:Nnn  #1#2#3
  {
    \cs_new_protected:Npn #1 ##1
      {
        \tl_retokenize:e
          {
            \exp_not:N \begin{#3}
            ##1
            #2
          }    
      }
  }
\cs_generate_variant:Nn \__codeverb_new_retokenize_envcs:Nnn {NV}  

\cs_new_protected:Npn \codeverb_new_retokenize_envcs:Nn #1#2
  {
    \str_set:Nn \l__codeverb_tmpa_tl { \end{#2} }
    \str_remove_all:Nn \l__codeverb_tmpa_tl {~}
    \__codeverb_new_retokenize_envcs:NVn #1 \l__codeverb_tmpa_tl {#2}
  }

\cs_new_protected:Npn \codeverb_new_retokenize_cs:N #1
  {
    \cs_set_eq:NN #1 \tl_retokenize:n
  }

\cs_new_protected:Npn \codeverb_new_retokenize_cs:NN #1#2
  {
    \cs_new_protected:Npn #1
      {
        \tl_retokenize:V #2
      }
  }




