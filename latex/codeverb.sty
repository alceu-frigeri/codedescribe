%%%%%%%
%%%
%%% Just an attempt at having my package's info in a regular way
%%%   \pkginfograb_set:nn {<pkg-name>} { props} sets package info
%%%
%%%   \pkginfograbProvidesExplPackage {<pkg-name>} { props} sets package info
%%%     and calls \ProvidesExplPackage
%%%
%%%%%%%
\RequirePackage{pkginfograb}
\pkginfograbProvidesExplPackage {codeverb}
  {
     name        = {codeverb} ,
     prefix      = {codeverb} ,
     date        = {2026/02/14} ,
     version     = {1.24a} ,
     description = {Verbatim Environment for codelisting}
  }
%%%%%%%
%%% End of cut-n-paste
%%%%%%%

\cs_generate_variant:Nn \regex_const:Nn {c}

\tl_new:N \g__codeverb_body_tl
\tl_new:N \l__codeverb_dummy_tl %% This is a dummy, to be 'absorbed'
\bool_new:N \l__codeverb_first_entry_bool
            
\tl_new:N \g__codeverb_tmpa_tl
\tl_new:N \l__codeverb_tmpa_tl

\tl_new:N \l__codeverb_left_tl
\tl_new:N \l__codeverb_right_tl

\seq_new:N \l__codeverb_tmpa_seq
\seq_new:N \l__codeverb_lastline_seq

%%% Just in case, but probably not nedded
%\str_const:Ne \c__codeverb_hidden_space_str
%  { \c_percent_str \c_circumflex_str \c_circumflex_str A scheol \c_percent_str }


\seq_new:N \l__codeverb_set_other_seq
\seq_set_from_clist:Nn \l__codeverb_set_other_seq
  { \ ,\\,\{,\},\$,\&,\#,\^,\^^K,\_,\^^A,\%,\~,\^^J }
\cs_new:Npn \__codeverb_set_others:
  {
    \seq_map_inline:Nn \l__codeverb_set_other_seq
      { \char_set_catcode_other:n {`##1} }
  }


\cs_new:Npn\__codeverb_env_begin:
  {
    \bool_set_true:N \l__codeverb_first_entry_bool
    \group_begin:
      \__codeverb_set_others:  
      \char_set_catcode_other:n {`\^^M}
      \__codeverb_linescan:w
  }


\group_begin:
  \char_set_catcode_other:n {`\^^M} \endlinechar=-1 
  \char_set_catcode_other:n {`\^^J}

  \cs_new:Npn \__codeverb_body_build:n #1 {}
  \cs_generate_variant:Nn \__codeverb_body_build:n {o,e}  

  \cs_new:Npn \__codeverb_set_env_linescan:NNNnN #1#2#3#4#5
    {
      \cs_new:cpn {__codeverb_#4_body_build:n} ##1
        {
          \bool_if:NTF \l__codeverb_first_entry_bool
            {
              \tl_if_blank:nTF {##1}
                {  }
                {
                  \tl_gput_right:Nn #5 {^^J}
                  \bool_set_false:N \l__codeverb_first_entry_bool
                  \tl_gput_right:Nn #5 {##1 ^^J}
                }
            }
            {
              \tl_gput_right:Nn #5 {##1 ^^J}
            }
        }
        
      \cs_new:cpn {__codeverb_#4_linescan:w} ##1 ^^M
        {
          \regex_split:NnNTF  #1 {##1} \l__codeverb_tmpa_seq
            {
              \int_gincr:N #3
            }
            {}
          \regex_split:NnNTF  #2 {##1} \l__codeverb_lastline_seq
            {
              \int_if_zero:nTF {#3}
                {
                  \seq_pop_left:NN \l__codeverb_lastline_seq \l__codeverb_left_tl
                  \seq_pop_left:NN \l__codeverb_lastline_seq \l__codeverb_left_tl
                  \seq_pop_right:NN \l__codeverb_lastline_seq \l__codeverb_right_tl
                  \seq_pop_right:NN \l__codeverb_lastline_seq \l__codeverb_right_tl
                  \tl_gset_eq:NN \g__codeverb_tmpa_tl \l__codeverb_right_tl
                  \cs_set:Npn \__next:
                    {
                      \__codeverb_body_build:o \l__codeverb_left_tl
                      \group_end: \end{#4} 
                      \tl_retokenize:V \g__codeverb_tmpa_tl
                    }
                }
                {
                  \int_gdecr:N #3
                  \cs_set:Npn \__next:
                    {
                      \__codeverb_body_build:n {##1}
                      \__codeverb_linescan:w
                    }
                }
            }
            {
              \cs_set:Npn \__next:
                {
                  \__codeverb_body_build:n {##1}
                  \__codeverb_linescan:w
                }
            }
            \__next:
        }    
    }
\group_end:
\cs_generate_variant:Nn \__codeverb_set_env_linescan:NNNnN {ccc}

\cs_new:Npn \__codeverb_new_scan_env:nN #1#2
  {
    \int_new:c {g__#1_cnt_int}
    \regex_const:cn {c__#1_begin_regex} {(.*)\\begin[\ ]*\{#1\}(.*)}
    \regex_const:cn {c__#1_end_regex}   {(.*)\\end[\ ]*\{#1\}(.*)}
    \__codeverb_set_env_linescan:cccnN {c__#1_begin_regex} {c__#1_end_regex} {g__#1_cnt_int} {#1} #2
  }


\cs_new:Npn \codeverb_new_environment:nnNnn #1#2#3#4#5
  {
    \__codeverb_new_scan_env:nN {#1} #3
    \NewDocumentEnvironment {#1}{#2}
      {
        #4
        \cs_set_eq:Nc \__codeverb_linescan:w   {__codeverb_#1_linescan:w}
        \cs_set_eq:Nc \__codeverb_body_build:n {__codeverb_#1_body_build:n}
        \tl_gclear:N #3
        \__codeverb_env_begin:
      }
      { #5 }
  }


